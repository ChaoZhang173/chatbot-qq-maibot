+"""人物事实写回的进程内去重缓存（仅标准库）。
+
+只在“抽取与必要写入都确认成功”之后记录；异常、超时、无法解析、写入未知都不记录为成功。
+进程重启后缓存为空，行为回退到“每个分段都可能再抽取一次”的原路径，不会丢失事实。
+"""
+
+from __future__ import annotations
+
+from collections import OrderedDict
+from contextlib import asynccontextmanager
+from dataclasses import dataclass, field
+from typing import Any, AsyncIterator, Callable, Dict, FrozenSet, Iterable, Optional
+
+import asyncio
+import hashlib
+import json
+import time
+
+# 抽取规则或解析逻辑有语义变化时递增；提示词规则文本的哈希另外并入键。
+EXTRACTION_VERSION = "pf-extract-v2"
+
+STATUS_DONE = "done"
+STATUS_PARTIAL = "partial"
+
+
+@dataclass
+class DedupEntry:
+    status: str
+    expires_at: float
+    fact_count: int = 0
+    written: FrozenSet[str] = field(default_factory=frozenset)
+    # 已抽取但尚未确认写入的候选；重试时必须保留，不能因模型第二次漏掉而视为完成。
+    pending: tuple = ()
+
+
+def fact_digest(fact: str) -> str:
+    return hashlib.sha256(" ".join(str(fact).split()).encode("utf-8")).hexdigest()[:16]
+
+
+def build_key(
+    *,
+    person_id: str,
+    scope: str,
+    evidence: Iterable[Iterable[str]],
+    extraction_version: str,
+) -> str:
+    """人物 + 会话/授权范围 + 证据（消息 ID、内容哈希、修订）+ 抽取版本。
+
+    evidence 的每一项是 (message_id, 内容哈希, 修订标记)；排序后哈希，顺序无关。
+    """
+
+    normalized = sorted([str(part) for part in item] for item in evidence)
+    payload = json.dumps(
+        [str(person_id), str(scope), normalized, str(extraction_version)],
+        ensure_ascii=False,
+        sort_keys=True,
+    )
+    return hashlib.sha256(payload.encode("utf-8")).hexdigest()
+
+
+class PersonFactDedupCache:
+    def __init__(
+        self,
+        *,
+        ttl_seconds: float = 900.0,
+        empty_ttl_seconds: float = 300.0,
+        partial_ttl_seconds: float = 120.0,
+        max_entries: int = 512,
+        clock: Callable[[], float] = time.monotonic,
+    ) -> None:
+        self.ttl_seconds = float(ttl_seconds)
+        self.empty_ttl_seconds = float(empty_ttl_seconds)
+        self.partial_ttl_seconds = float(partial_ttl_seconds)
+        self.max_entries = max(1, int(max_entries))
+        self._clock = clock
+        self._entries: "OrderedDict[str, DedupEntry]" = OrderedDict()
+        self._locks: Dict[str, asyncio.Lock] = {}
+        self._lock_users: Dict[str, int] = {}
+
+    def __len__(self) -> int:
+        return len(self._entries)
+
+    def configure(self, settings: Dict[str, Any]) -> None:
+        self.ttl_seconds = float(settings.get("ttl_seconds", self.ttl_seconds))
+        self.empty_ttl_seconds = float(settings.get("empty_ttl_seconds", self.empty_ttl_seconds))
+        self.partial_ttl_seconds = float(settings.get("partial_ttl_seconds", self.partial_ttl_seconds))
+        self.max_entries = max(1, int(settings.get("max_entries", self.max_entries)))
+
+    def _purge_expired(self) -> None:
+        now = self._clock()
+        for key in [key for key, entry in self._entries.items() if entry.expires_at <= now]:
+            del self._entries[key]
+
+    def lookup(self, key: str) -> Optional[DedupEntry]:
+        entry = self._entries.get(key)
+        if entry is None:
+            return None
+        if entry.expires_at <= self._clock():
+            del self._entries[key]
+            return None
+        return entry
+
+    def _store(self, key: str, entry: DedupEntry) -> None:
+        self._purge_expired()
+        self._entries[key] = entry
+        self._entries.move_to_end(key)
+        while len(self._entries) > self.max_entries:
+            self._entries.popitem(last=False)
+
+    def record_success(self, key: str, *, fact_count: int, written: Iterable[str] = ()) -> None:
+        ttl = self.ttl_seconds if fact_count > 0 else self.empty_ttl_seconds
+        self._store(
+            key,
+            DedupEntry(STATUS_DONE, self._clock() + ttl, fact_count=fact_count, written=frozenset(written)),
+        )
+
+    def record_partial(self, key: str, *, written: Iterable[str], pending: Iterable[Any] = ()) -> None:
+        """未完成：记住已写入的摘要与待写入候选；整体不视为完成，重试时先补写候选。"""
+
+        self._store(
+            key,
+            DedupEntry(
+                STATUS_PARTIAL,
+                self._clock() + self.partial_ttl_seconds,
+                fact_count=len(frozenset(written)),
+                written=frozenset(written),
+                pending=tuple(pending)[:8],
+            ),
+        )
+
+    def forget(self, key: str) -> None:
+        self._entries.pop(key, None)
+
+    @asynccontextmanager
+    async def guard(self, key: str) -> AsyncIterator[None]:
+        """同一键的并发处理串行化；后到者进入时再检查缓存，避免双写。"""
+
+        lock = self._locks.get(key)
+        if lock is None:
+            lock = self._locks[key] = asyncio.Lock()
+        self._lock_users[key] = self._lock_users.get(key, 0) + 1
+        try:
+            async with lock:
+                yield
+        finally:
+            self._lock_users[key] -= 1
+            if self._lock_users[key] <= 0:
+                self._lock_users.pop(key, None)
+                self._locks.pop(key, None)
