+"""窄范围“回复成功后本地结束本轮”的判定（实验选项，默认关闭）。
+
+只在 planner 工具批次执行完毕之后判断，不在 reply 工具上设置 ``stop_after_execution``。
+判定是纯函数：输入全是结构化事实，**不读取回复文本，也不依据私聊/群聊身份猜测**。
+任何一项未知或不满足，都返回“继续原流程”，并带上单独的原因代码。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Sequence
+
+# 停止原因；cycle_end.reason 同名，便于监控中单独统计。
+REPLY_LOCAL_STOP_REASON = "reply_completed_local_stop"
+
+MODE_EXPLICIT = "explicit"
+CONTINUE_UNKNOWN_MODE = "unknown_mode"
+
+# 继续原流程的原因代码
+CONTINUE_DISABLED = "disabled"
+CONTINUE_NOT_FIRST_ROUND = "not_first_round"
+CONTINUE_FOCUS_MODE = "focus_mode"
+CONTINUE_INTERNAL_TRIGGER = "proactive_or_timeout_turn"
+CONTINUE_SOURCE_UNVERIFIED = "batch_source_unverified_or_non_chat"
+CONTINUE_BATCH_NOT_SINGLE = "batch_not_single_external_message"
+CONTINUE_MULTIPLE_TOOLS = "multiple_or_non_reply_tools"
+CONTINUE_REPLY_FAILED = "reply_not_successful"
+CONTINUE_SEGMENTS_UNCONFIRMED = "segments_not_all_confirmed"
+CONTINUE_TARGET_MISMATCH = "reply_target_not_the_batch_message"
+CONTINUE_EXTRA_RESULTS = "extra_tool_results_or_media"
+CONTINUE_NO_SIGNAL = "no_explicit_final_signal"
+CONTINUE_PENDING_MESSAGES = "new_messages_pending"
+CONTINUE_PENDING_WAIT = "wait_pending"
+CONTINUE_INTERNAL_QUEUE = "internal_trigger_queued"
+CONTINUE_UNKNOWN_STATE = "runtime_state_unknown"
+STOP_OK = "stop"
+
+
+@dataclass(frozen=True)
+class TurnFacts:
+    """本次内部轮次的来源事实，由 run_loop 在轮次开始时记录。"""
+
+    round_index: int = 0
+    batch_external_message_ids: tuple[str, ...] = ()
+    proactive_triggered: bool = False
+    timeout_triggered: bool = False
+    focus_mode: bool = False
+    # 批次里每一项都已确认是“普通外部聊天消息”（非机器人、非命令、非通知、有消息 ID）；默认 False（未知即禁用）。
+    sources_verified: bool = False
+
+
+@dataclass(frozen=True)
+class ToolOutcome:
+    """一次已执行的工具调用的结构化结果。"""
+
+    tool_name: str
+    success: bool
+    target_message_id: str = ""
+    final_reply: bool | None = None
+    segment_send_success: tuple[bool, ...] = ()
+    expected_segments: int = 0
+    has_extra_results: bool = False
+
+
+@dataclass(frozen=True)
+class RuntimeFacts:
+    """判定时刻的运行时状态；任何字段为 None 表示无法确认。"""
+
+    has_pending_messages: bool | None
+    has_pending_wait: bool | None
+    internal_queue_empty: bool | None
+
+
+@dataclass(frozen=True)
+class Decision:
+    stop: bool
+    reason: str
+
+
+def extract_final_reply_signal(arguments: Any) -> bool | None:
