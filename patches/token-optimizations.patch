+
+def _definition_name(definition: Mapping[str, Any]) -> str:
+    function = definition.get("function")
+    source = function if isinstance(function, Mapping) else definition
+    return str(source.get("name") or "")
+
+
+def add_final_reply_parameter(definitions: Sequence[Any], settings: Mapping[str, Any]) -> list[Any]:
+    """仅在实验开启（explicit）时，为 reply 的工具定义追加可选 final_reply 参数。
+
+    未开启、形状无法识别时原样返回，所以默认路径的工具定义字节不变。
