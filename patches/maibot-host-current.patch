+"""Token 优化实验开关（仅标准库，便于离线测试）。
+
+默认值：
+- 全部默认关闭。建议灰度顺序：先只启用 ``person_fact_dedup``（P4），观察后再考虑其它实验。
+- ``person_fact_dedup``：只跳过“同一人物、同一会话、同一证据、同一抽取版本”的重复抽取。
+- ``reply_termination``：实验选项，见 ``src/maisaka/reply_termination.py``。
+- 配置文件损坏、读取失败、字段类型错误或数值非有限，一律回退到上述默认（关闭）。
+
+配置来源（后者覆盖前者）：内置默认值 → 环境变量 ``MAIBOT_TOKEN_OPT_CONFIG`` 指向的 JSON 文件
+（每 5 秒最多重读一次，删除文件即回退默认）→ 单项环境变量
+``MAIBOT_TOKEN_OPT_PERSON_FACT_DEDUP`` / ``MAIBOT_TOKEN_OPT_REPLY_TERMINATION``（1/0）。
+读取失败一律回退到内置默认值，不抛出异常。
+"""
+
+from __future__ import annotations
+
+from copy import deepcopy
+from typing import Any, Dict
+
+import hashlib
+import json
+import math
+import os
+import threading
+import time
+
+ENV_CONFIG_PATH = "MAIBOT_TOKEN_OPT_CONFIG"
+ENV_PERSON_FACT_DEDUP = "MAIBOT_TOKEN_OPT_PERSON_FACT_DEDUP"
+ENV_REPLY_TERMINATION = "MAIBOT_TOKEN_OPT_REPLY_TERMINATION"
+_FILE_REFRESH_SECONDS = 5.0
+
+DEFAULTS: Dict[str, Dict[str, Any]] = {
+    "person_fact_dedup": {
+        "enabled": False,
+        "ttl_seconds": 900.0,
+        "empty_ttl_seconds": 300.0,
+        "partial_ttl_seconds": 120.0,
+        "max_entries": 512,
+    },
+    "reply_termination": {
+        # 只有 enabled=true 才会改变任何行为。
+        "enabled": False,
+        # 目前只有 explicit：planner 必须在 reply 参数里显式给出 final_reply=true。
+        # 未知模式一律视为不终结（继续原流程）。
+        "mode": "explicit",
+    },
+}
+
+_lock = threading.Lock()
+_file_cache: Dict[str, Any] = {"path": None, "loaded_at": -1e9, "data": {}, "ok": True}
+
+
+def _parse_bool(raw: str) -> bool | None:
+    value = str(raw).strip().lower()
+    if value in {"1", "true", "yes", "on"}:
+        return True
+    if value in {"0", "false", "no", "off"}:
+        return False
+    return None
+
+
+def _read_file_config() -> tuple[Dict[str, Any], bool]:
+    """返回 (配置, 是否可信)。指定了配置文件却读不到/不是 JSON 对象时不可信（整体关闭）。"""
+
+    path = os.environ.get(ENV_CONFIG_PATH, "").strip()
+    now = time.monotonic()
+    with _lock:
+        if (
+            _file_cache["path"] == path
+            and now - float(_file_cache["loaded_at"]) < _FILE_REFRESH_SECONDS
+        ):
+            return _file_cache["data"], _file_cache["ok"]
+        data: Dict[str, Any] = {}
+        ok = True
+        if path:
+            try:
+                with open(path, "r", encoding="utf-8") as handle:
+                    loaded = json.load(handle)
+                if isinstance(loaded, dict):
+                    data = loaded
+                else:
+                    ok = False
+            except (OSError, ValueError):
+                ok = False
+        _file_cache.update(path=path, loaded_at=now, data=data, ok=ok)
+        return data, ok
+
+
+def reset_cache_for_tests() -> None:
+    with _lock:
+        _file_cache.update(path=None, loaded_at=-1e9, data={}, ok=True)
+
+
+def get_settings(section: str) -> Dict[str, Any]:
+    """返回某个实验的当前设置（fail-closed）。
+
+    配置文件不可信、该 section 不是对象、其中任何已知字段非法（类型错误、非有限数、非正数、
+    整数字段给了非整数），或单项环境变量无法解析时，整个 section 回到默认的关闭状态。
+    单项环境变量只能覆盖有效配置的 enabled，不能绕过上述关闭规则。
+    """
+
+    closed = deepcopy(DEFAULTS[section])
+    base = deepcopy(closed)
+    data, ok = _read_file_config()
+    if not ok:
+        return closed
+    if section in data:
+        override = data[section]
+        if not isinstance(override, dict):
+            return closed
+        for key, default in DEFAULTS[section].items():
+            if key not in override:
+                continue
+            value = override[key]
+            if isinstance(default, bool):
+                if not isinstance(value, bool):
+                    return closed
+                base[key] = value
+            elif isinstance(default, int):
+                if isinstance(value, bool) or not isinstance(value, (int, float)):
+                    return closed
+                if not math.isfinite(value) or value != int(value) or int(value) <= 0:
+                    return closed
+                base[key] = int(value)
+            elif isinstance(default, float):
+                if isinstance(value, bool) or not isinstance(value, (int, float)):
+                    return closed
+                if not math.isfinite(value) or value <= 0:
+                    return closed
+                base[key] = float(value)
+            elif isinstance(default, str):
+                if not isinstance(value, str) or not value:
+                    return closed
+                base[key] = value
+    env_name = {"person_fact_dedup": ENV_PERSON_FACT_DEDUP, "reply_termination": ENV_REPLY_TERMINATION}.get(section)
+    if env_name and env_name in os.environ:
+        parsed = _parse_bool(os.environ[env_name])
+        if parsed is None:
+            return closed
+        base["enabled"] = parsed
+    return base
+
+
+def fingerprint(*parts: Any, length: int = 12) -> str:
+    """稳定、不可逆的短指纹；用于日志归因，不记录原始聊天或密钥。"""
+
+    payload = json.dumps(parts, ensure_ascii=False, sort_keys=True, default=str)
+    return hashlib.sha256(payload.encode("utf-8")).hexdigest()[:length]
