+// clickReplyControl uses a real pointer click after checking that the control is
+// visible at its center. It never invokes a hidden DOM click or retries a submit.
+func clickReplyControl(el *rod.Element) error {
+	if _, err := el.Eval(`() => this.scrollIntoView({block:"center", inline:"nearest", behavior:"instant"})`); err != nil {
+		return err
+	}
+	time.Sleep(150 * time.Millisecond)
+	hit, err := el.Eval(`() => {
+        const r=this.getBoundingClientRect(), x=r.left+r.width/2, y=r.top+r.height/2;
+        const hit=document.elementFromPoint(x,y);
+        return r.width>0 && r.height>0 && getComputedStyle(this).visibility!=="hidden" && (hit===this || this.contains(hit));
+    }`)
+	if err != nil {
+		return err
+	}
+	if !hit.Value.Bool() {
+		return fmt.Errorf("reply_button_obscured")
+	}
+	return humanize.ClickNoWait(el)
+}
