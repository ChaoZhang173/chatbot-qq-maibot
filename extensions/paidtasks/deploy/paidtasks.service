[Unit]
Description=Bounded Afdian paid task pilot
After=network-online.target maibot.service
Wants=network-online.target

[Service]
Type=simple
User=maibot
Group=maibot
WorkingDirectory=/srv/maibot/paid
Environment=PYTHONPATH=/opt/maibot/paidtasks-current
Environment=PAIDTASKS_ROOT=/srv/maibot/paid
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OMP_NUM_THREADS=1
EnvironmentFile=/srv/maibot/paid/afdian.env
ExecStart=/opt/maibot/tools/maibot/bin/python -m paidtasks.runtime
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
MemoryMax=192M
CPUQuota=40%
TasksMax=32
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/maibot/paid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
