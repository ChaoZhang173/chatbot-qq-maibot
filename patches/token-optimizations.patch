+    if outcome.final_reply is not True:
+        return Decision(False, CONTINUE_NO_SIGNAL)
+    if None in (runtime.has_pending_messages, runtime.has_pending_wait, runtime.internal_queue_empty):
+        return Decision(False, CONTINUE_UNKNOWN_STATE)
+    if runtime.has_pending_messages:
+        return Decision(False, CONTINUE_PENDING_MESSAGES)
+    if runtime.has_pending_wait:
