# Copy outside the repository, fill private values, then load into your service environment.
PASSPORT_HOST=127.0.0.1
PASSPORT_PORT=8443
PASSPORT_TLS_CERT=/etc/passport/tls/server.crt
PASSPORT_TLS_KEY=/etc/passport/tls/server.key
PASSPORT_BINDINGS=/etc/passport/device-bindings.json
PASSPORT_BACKEND=http
PASSPORT_BACKEND_URL=https://chat.example/v1/voice
PASSPORT_BACKEND_API_KEY=
PASSPORT_HTTP_REMINDERS=0
PASSPORT_PROVIDER=siliconflow
SILICONFLOW_API_KEY=
PASSPORT_TTS_STYLE=
PASSPORT_TTS_STYLE_SOFT=
# Never enable simulated speech for a real deployment.
PASSPORT_TEST_MODE=0
