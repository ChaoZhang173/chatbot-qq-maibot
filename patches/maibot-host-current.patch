+"""Authenticated, plugin-scoped Host capability: one Passport voice turn through the real Maisaka pipeline.
+
+Registered next to `unified.memory`; AuthorizationManager only lets a plugin call it if its manifest lists
+`unified.voice` in `capabilities_required`. The caller (local.unified-core) has already validated the device ->
+owner binding, reserved the idempotency record durably and verified the session; this adapter re-checks the
+session identity against the Host's own chat session and bounds concurrency and time.
+"""
+import asyncio
+import re
+import time
+
+PLUGIN_ID = 'local.unified-core'
+MAX_CONCURRENT = 3
+MAX_FRIEND = 2        # restricted (friend/profile) turns can never take the last slot: the owner keeps one
+KINDS = ('owner', 'qq_linked', 'passport')
+TOOL_NAME_RE = re.compile(r'^[A-Za-z0-9_.-]{1,64}$')
+ADDRESS_RE = re.compile(r'^[\w\u4e00-\u9fff\u00b7 -]{1,16}$')
+_active = {}          # key -> asyncio.Task (one per running turn)
+_restricted = set()   # keys of running friend/profile turns
+_sessions = {}        # session_id -> asyncio.Lock (voice turns for one owner session never run concurrently)
+
+
+def _text(args, name, maximum):
+    value = args.get(name)
+    if not isinstance(value, str) or not 1 <= len(value) <= maximum:
+        raise ValueError('voice_' + name)
+    return value
+
+
+async def unified_voice(plugin_id, capability, args):
+    if plugin_id != PLUGIN_ID or capability != 'unified.voice':
+        raise PermissionError('voice_plugin_denied')
+    if not isinstance(args, dict):
+        raise ValueError('voice_arguments')
+    key = args.get('key')
+    if not isinstance(key, str) or not re.fullmatch(r'[a-f0-9]{64}', key):
+        raise ValueError('voice_key')
+    if args.get('operation') == 'cancel':
+        if set(args) != {'operation', 'key'}:
+            raise ValueError('voice_cancel_arguments')
+        task = _active.get(key)
+        if task is not None and not task.done():
+            task.cancel()
+        return {'cancel_requested': task is not None}
+    base = {'operation', 'key', 'session_id', 'owner_id', 'account_id', 'text', 'history', 'timeout_s'}
+    if args.get('operation') != 'run' or not base <= set(args) <= base | {'kind', 'preferred_address', 'tool_allowlist'}:
+        raise ValueError('voice_arguments')
+    kind = args.get('kind', 'owner')
+    if kind not in KINDS:
+        raise ValueError('voice_kind')
+    if 'preferred_address' in args and (not isinstance(args['preferred_address'], str)
+                                        or not ADDRESS_RE.match(args['preferred_address'])):
+        raise ValueError('voice_preferred_address')
+    allowlist = args.get('tool_allowlist')
+    if kind == 'owner':
+        if allowlist is not None:
+            raise ValueError('voice_owner_allowlist')       # the owner route is the unrestricted one
+    elif (not isinstance(allowlist, list) or not 1 <= len(allowlist) <= 32
+          or any(not isinstance(name, str) or not TOOL_NAME_RE.match(name) for name in allowlist)):
+        raise ValueError('voice_tool_allowlist')            # a restricted route without an allowlist is refused
+    if key in _active:
+        raise ValueError('voice_already_running')
+    restricted = kind != 'owner'
+    if len(_active) >= MAX_CONCURRENT or (restricted and len(_restricted) >= MAX_FRIEND):
+        return {'success': False, 'error': 'voice_busy'}      # nothing started; the caller may retry
+    for name, maximum in (('session_id', 256), ('owner_id', 256), ('account_id', 256), ('text', 1000)):
+        _text(args, name, maximum)
+    timeout = args['timeout_s']
+    if isinstance(timeout, bool) or not isinstance(timeout, (int, float)) or not 0 < timeout <= 24:
+        raise ValueError('voice_deadline')
+    history = args['history']
+    if not isinstance(history, list) or len(history) > 8 or any(
+            not isinstance(row, dict) or set(row) != {'speaker', 'channel', 'text'}
+            or any(not isinstance(value, str) or len(value) > 400 for value in row.values()) for row in history):
+        raise ValueError('voice_history')
+    from src.maisaka.voice_entry import run_voice_turn
+    started = time.monotonic()
+    deadline = started + float(timeout)
+    lock = _sessions.setdefault(args['session_id'], asyncio.Lock())
+
+    async def guarded():
+        # Waiting for a previous turn of the same session counts against this turn's own deadline.
+        await asyncio.wait_for(lock.acquire(), max(0.01, deadline - time.monotonic()))
+        try:
+            return await run_voice_turn(args, deadline)
+        finally:
+            lock.release()
+
+    task = asyncio.create_task(guarded())
+    _active[key] = task
+    if restricted:
+        _restricted.add(key)
+    try:
+        return await asyncio.wait_for(task, max(0.01, deadline - time.monotonic()))
+    except asyncio.TimeoutError:
+        return {'success': False, 'error': 'voice_timeout'}
+    except asyncio.CancelledError:
+        task.cancel()
+        if asyncio.current_task().cancelling():
+            raise            # the caller's RPC was cancelled: stop our work, then propagate (never swallow it)
+        return {'success': False, 'error': 'voice_cancelled'}   # cancelled through the explicit cancel operation
+    except PermissionError as exc:
+        return {'success': False, 'error': str(exc)[:100] or 'voice_denied'}
+    except Exception as exc:
+        return {'success': False, 'error': (str(exc) or type(exc).__name__)[:100]}
+    finally:
+        if _active.get(key) is task:
+            _active.pop(key, None)
+        _restricted.discard(key)
+        if not task.done():
+            task.cancel()
