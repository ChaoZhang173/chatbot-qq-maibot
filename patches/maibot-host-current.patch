+"""窄范围“回复成功后本地结束本轮”的判定（实验选项，默认关闭）。
+
+只在 planner 工具批次执行完毕之后判断，不在 reply 工具上设置 ``stop_after_execution``。
+判定是纯函数：输入全是结构化事实，**不读取回复文本，也不依据私聊/群聊身份猜测**。
+任何一项未知或不满足，都返回“继续原流程”，并带上单独的原因代码。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Sequence
+
+# 停止原因；cycle_end.reason 同名，便于监控中单独统计。
+REPLY_LOCAL_STOP_REASON = "reply_completed_local_stop"
+
+MODE_EXPLICIT = "explicit"
+CONTINUE_UNKNOWN_MODE = "unknown_mode"
+
+# 继续原流程的原因代码
+CONTINUE_DISABLED = "disabled"
+CONTINUE_NOT_FIRST_ROUND = "not_first_round"
+CONTINUE_FOCUS_MODE = "focus_mode"
+CONTINUE_INTERNAL_TRIGGER = "proactive_or_timeout_turn"
+CONTINUE_SOURCE_UNVERIFIED = "batch_source_unverified_or_non_chat"
+CONTINUE_BATCH_NOT_SINGLE = "batch_not_single_external_message"
+CONTINUE_MULTIPLE_TOOLS = "multiple_or_non_reply_tools"
+CONTINUE_REPLY_FAILED = "reply_not_successful"
+CONTINUE_SEGMENTS_UNCONFIRMED = "segments_not_all_confirmed"
+CONTINUE_TARGET_MISMATCH = "reply_target_not_the_batch_message"
+CONTINUE_EXTRA_RESULTS = "extra_tool_results_or_media"
+CONTINUE_NO_SIGNAL = "no_explicit_final_signal"
+CONTINUE_PENDING_MESSAGES = "new_messages_pending"
+CONTINUE_PENDING_WAIT = "wait_pending"
+CONTINUE_INTERNAL_QUEUE = "internal_trigger_queued"
+CONTINUE_UNKNOWN_STATE = "runtime_state_unknown"
+STOP_OK = "stop"
+
+
+@dataclass(frozen=True)
+class TurnFacts:
+    """本次内部轮次的来源事实，由 run_loop 在轮次开始时记录。"""
+
+    round_index: int = 0
+    batch_external_message_ids: tuple[str, ...] = ()
+    proactive_triggered: bool = False
+    timeout_triggered: bool = False
+    focus_mode: bool = False
+    # 批次里每一项都已确认是“普通外部聊天消息”（非机器人、非命令、非通知、有消息 ID）；默认 False（未知即禁用）。
+    sources_verified: bool = False
+
+
+@dataclass(frozen=True)
+class ToolOutcome:
+    """一次已执行的工具调用的结构化结果。"""
+
+    tool_name: str
+    success: bool
+    target_message_id: str = ""
+    final_reply: bool | None = None
+    segment_send_success: tuple[bool, ...] = ()
+    expected_segments: int = 0
+    has_extra_results: bool = False
+
+
+@dataclass(frozen=True)
+class RuntimeFacts:
+    """判定时刻的运行时状态；任何字段为 None 表示无法确认。"""
+
+    has_pending_messages: bool | None
+    has_pending_wait: bool | None
+    internal_queue_empty: bool | None
+
+
+@dataclass(frozen=True)
+class Decision:
+    stop: bool
+    reason: str
+
+
+def extract_final_reply_signal(arguments: Any) -> bool | None:
+    """从 reply 工具参数读取结构化 final_reply；只接受布尔值，其它一律视为未给出。"""
+
+    if not isinstance(arguments, Mapping):
+        return None
+    if set(arguments) == {"arguments"} and isinstance(arguments["arguments"], str):
+        import json
+
+        try:
+            parsed = json.loads(arguments["arguments"])
+        except ValueError:
+            return None
+        arguments = parsed if isinstance(parsed, Mapping) else {}
+    value = arguments.get("final_reply")
+    return value if isinstance(value, bool) else None
+
+
+FINAL_REPLY_SCHEMA = {
+    "type": "boolean",
+    "description": (
+        "可选。只有这条回复已经完整回应、没有任何后续承诺（如稍后查询、继续说明）、"
+        "也不需要再查看新信息或调用其他工具时才填 true；不确定就不要填。"
+    ),
+}
+
+
+def _definition_name(definition: Mapping[str, Any]) -> str:
+    function = definition.get("function")
+    source = function if isinstance(function, Mapping) else definition
+    return str(source.get("name") or "")
+
+
+def add_final_reply_parameter(definitions: Sequence[Any], settings: Mapping[str, Any]) -> list[Any]:
+    """仅在实验开启（explicit）时，为 reply 的工具定义追加可选 final_reply 参数。
+
+    未开启、形状无法识别时原样返回，所以默认路径的工具定义字节不变。
+    """
+
+    if not (settings.get("enabled") and settings.get("mode") == MODE_EXPLICIT):
+        return list(definitions)
+    import copy
+
+    result: list[Any] = []
+    for definition in definitions:
+        if isinstance(definition, Mapping) and _definition_name(definition) == "reply":
+            updated = copy.deepcopy(dict(definition))
+            holder = updated.get("function") if isinstance(updated.get("function"), dict) else updated
+            for key in ("parameters", "input_schema", "parameters_schema"):
+                schema = holder.get(key)
+                if isinstance(schema, dict) and isinstance(schema.get("properties"), dict):
+                    schema["properties"].setdefault("final_reply", copy.deepcopy(FINAL_REPLY_SCHEMA))
+                    break
+            definition = updated
+        result.append(definition)
+    return result
+
+
+def strip_final_reply_argument(invocation: Any) -> None:
+    """从即将传给 reply 工具的参数中移除 final_reply（含被 arguments 字符串包裹的形式）。"""
+
+    arguments = getattr(invocation, "arguments", None)
+    if not isinstance(arguments, dict):
+        return
+    arguments.pop("final_reply", None)
+    if set(arguments) == {"arguments"} and isinstance(arguments["arguments"], str):
+        import json
+
+        try:
+            parsed = json.loads(arguments["arguments"])
+        except ValueError:
+            return
+        if isinstance(parsed, dict) and "final_reply" in parsed:
+            parsed.pop("final_reply")
+            arguments["arguments"] = json.dumps(parsed, ensure_ascii=False)
+
+
+def decide(
+    settings: Mapping[str, Any],
+    turn: TurnFacts,
+    planned_tool_names: Sequence[str],
+    outcomes: Sequence[ToolOutcome],
+    runtime: RuntimeFacts,
+) -> Decision:
+    if not bool(settings.get("enabled")):
+        return Decision(False, CONTINUE_DISABLED)
+    if turn.round_index != 0:
+        return Decision(False, CONTINUE_NOT_FIRST_ROUND)
+    if turn.focus_mode:
+        return Decision(False, CONTINUE_FOCUS_MODE)
+    if turn.proactive_triggered or turn.timeout_triggered:
+        return Decision(False, CONTINUE_INTERNAL_TRIGGER)
+    if not turn.sources_verified:
+        return Decision(False, CONTINUE_SOURCE_UNVERIFIED)
+    if len(turn.batch_external_message_ids) != 1 or not turn.batch_external_message_ids[0]:
+        return Decision(False, CONTINUE_BATCH_NOT_SINGLE)
+    if len(planned_tool_names) != 1 or planned_tool_names[0] != "reply" or len(outcomes) != 1:
+        return Decision(False, CONTINUE_MULTIPLE_TOOLS)
+    outcome = outcomes[0]
+    if outcome.tool_name != "reply" or not outcome.success:
+        return Decision(False, CONTINUE_REPLY_FAILED)
+    if (
+        outcome.expected_segments <= 0
+        or len(outcome.segment_send_success) != outcome.expected_segments
+        or not all(outcome.segment_send_success)
+    ):
+        return Decision(False, CONTINUE_SEGMENTS_UNCONFIRMED)
+    if outcome.has_extra_results:
+        return Decision(False, CONTINUE_EXTRA_RESULTS)
+    if outcome.target_message_id != turn.batch_external_message_ids[0]:
+        return Decision(False, CONTINUE_TARGET_MISMATCH)
+    if settings.get("mode") != MODE_EXPLICIT:
+        return Decision(False, CONTINUE_UNKNOWN_MODE)
+    # 只接受明确的 final_reply=true；缺失、false、非布尔都继续原流程。
+    if outcome.final_reply is not True:
+        return Decision(False, CONTINUE_NO_SIGNAL)
+    if None in (runtime.has_pending_messages, runtime.has_pending_wait, runtime.internal_queue_empty):
+        return Decision(False, CONTINUE_UNKNOWN_STATE)
+    if runtime.has_pending_messages:
+        return Decision(False, CONTINUE_PENDING_MESSAGES)
+    if runtime.has_pending_wait:
+        return Decision(False, CONTINUE_PENDING_WAIT)
+    if not runtime.internal_queue_empty:
+        return Decision(False, CONTINUE_INTERNAL_QUEUE)
+    return Decision(True, STOP_OK)
